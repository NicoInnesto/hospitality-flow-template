---
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealScript from "../components/RevealScript.astro";
import { menuSections } from "../data/menu";
import { site } from "../config/site";
---

<BaseLayout title={`Menu — ${site.name} ${site.signature}`} description="Una selezione di colazioni, proposte salate, aperitivi e drink del Bar Mascagni Panta Rei.">
  <div class="menu-page">
  <header class="menu-hero">
    <div class="menu-hero__copy" data-reveal>
      <p class="eyebrow">Dall’apertura all’ultimo bicchiere</p>
      <h1>Il menu segue il ritmo della giornata.</h1>
      <p>Una selezione essenziale, pensata per essere aggiornata facilmente con disponibilità, prezzi e allergeni del locale.</p>
    </div>
    <div class="menu-hero__visual" aria-hidden="true" data-reveal>
      <span class="menu-orbit menu-orbit--one"></span>
      <span class="menu-orbit menu-orbit--two"></span>
      <div class="menu-clock">
        <span>05:00</span>
        <strong>Una giornata<br />al bancone</strong>
        <span>01:30</span>
      </div>
    </div>
  </header>

  <section class="menu-content" aria-labelledby="menu-title">
    <h2 id="menu-title" class="sr-only">Categorie del menu</h2>
    <div class="menu-grid">
      {menuSections.map((section, index) => (
        <article class={`menu-card menu-card--${index + 1}`} data-reveal>
          <div class="menu-card__top">
            <div>
              <span class="menu-card__number">{section.number}</span>
              <h3>{section.title}</h3>
            </div>
            <p class="menu-card__note">{section.note}</p>
          </div>
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <div class="menu-note" data-reveal>
      <span>Nota</span>
      <p>Questo è un menu dimostrativo. Prodotti, prezzi, disponibilità e allergeni saranno inseriti dopo il confronto con il locale.</p>
    </div>
  </section>
  </div>
  <RevealScript />
</BaseLayout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
